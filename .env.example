# Copy to .env at the repo root and fill in. Forge loads .env automatically for every `forge script` run, so the
# pnpm ccip:* commands pick these up without sourcing the file. Never commit .env.
#
# Optional variables are commented out: leave them commented unless you need them.
# Lists are comma-separated with no spaces; numbers can be decimal or 0x hex.
# CCIP router addresses and chain selectors: https://docs.chain.link/ccip/directory

# ------------------------------------------------------------------------------------------------------------------
# Target chain (used by --rpc-url ccip)
# ------------------------------------------------------------------------------------------------------------------

RPC_URL=
# Used by --verify. Works across chains with the Etherscan V2 API.
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------------------------------------------
# pnpm ccip:deploy (factory deploy + full configuration in one broadcast)
# pnpm ccip:deploy-adapter-only uses only ROUTER and the three role addresses.
# ------------------------------------------------------------------------------------------------------------------

# CCIP router on the target chain.
ROUTER=
# Receives DEFAULT_ADMIN_ROLE (configuration, targets, recovery). Use a multisig in production.
DEFAULT_ADMIN=
# Receives FEE_SETTER_ROLE (return-leg fees).
FEE_SETTER=
# Receives FEE_COLLECTOR_ROLE (withdraws collected fees).
FEE_COLLECTOR=
# Initial processing toggles.
DEPOSITS_ENABLED=true
REDEEMS_ENABLED=true

# ERC-4626 vault to allow. TARGET_ENABLED defaults to true when VAULT_TARGET is set.
# VAULT_TARGET=
# TARGET_ENABLED=true

# Remote chains that may send to and receive from the adapter. Types: 1 = EVM, 2 = SVM (Solana), 0 = disabled.
# CHAIN_SELECTORS=16015286601757825753,16423721717087811551
# CHAIN_TYPES=1,2

# Return-leg fee rows (parallel lists). The bridged token is the vault share for deposit returns or the underlying
# for redeem returns; the fee is in vault underlying units and applies only when the result returns to the source.
# FEE_DESTINATION_CHAIN_SELECTORS=16015286601757825753
# FEE_BRIDGED_TOKENS=0xVaultShareToken
# FEE_VALUES=1000000

# Deploy through an existing CrossChainERC4626AdapterFactory instead of a new one.
# FACTORY=
# Deployment record path, written only with --broadcast. Default deployments/ccip/<chainId>.json; empty disables.
# DEPLOYMENT_OUT=

# ------------------------------------------------------------------------------------------------------------------
# pnpm ccip:configure (run as DEFAULT_ADMIN after deploying)
# ------------------------------------------------------------------------------------------------------------------

# Adapter to configure. ccip:check falls back to the deployment record when this is unset.
# ADAPTER=

# Return-lane extraArgs format per destination chain: 1 = GenericExtraArgsV2 (CCIP v1 lanes; also what an unset lane
# uses), 2 = GenericExtraArgsV3 basic (CCIP v2 lanes).
# RETURN_LANE_SELECTORS=16015286601757825753
# RETURN_LANE_FORMATS=2

# Requested finality for returns of a bridged token on a v2 lane (set the lane format first).
# 0x00000000 = wait for finality, 0x00010000 = safe tag, 1..65535 = that many blocks.
# RETURN_FINALITY_SELECTORS=16015286601757825753
# RETURN_FINALITY_TOKENS=0xVaultShareToken
# RETURN_FINALITIES=0x00010000

# Allowed finality for inbound messages per source chain (CCIP v2). Unset means wait for finality.
# INBOUND_FINALITY_SELECTORS=16015286601757825753
# INBOUND_FINALITIES=0x00010000

# CCV policy for one source chain (CCIP v2). Unset means the lane's default verifiers.
# CCV_SOURCE_SELECTOR=16015286601757825753
# CCV_REQUIRED=0xCcvAddress
# CCV_OPTIONAL=
# CCV_OPTIONAL_THRESHOLD=0

# Native amount (wei) to send to the adapter for return-leg CCIP fees. Anyone can fund; no role needed.
# FUND_NATIVE_WEI=100000000000000000

# ------------------------------------------------------------------------------------------------------------------
# pnpm ccip:build-payload (read-only: prints the 128-byte user request payload; no --account needed)
# ------------------------------------------------------------------------------------------------------------------

# Token as the adapter receives it: the vault's asset for a deposit, the vault itself for a redemption.
REQUEST_TOKEN=
# Allowlisted vault the request acts on. Defaults to the vaultTarget field of deployments/ccip/<chainId>.json.
# REQUEST_TARGET=
# Amount in REQUEST_TOKEN's smallest units, for example 100000000000000000 for 0.1 of an 18-decimal token.
AMOUNT=
# Chain selector of the chain the request is sent from, for example 3478487238524512106 for Arbitrum Sepolia.
SOURCE_CHAIN_SELECTOR=
# Slippage tolerance in basis points, an explicit choice: minimumOut = preview * (10_000 - TOLERANCE_BPS) / 10_000.
# 100 is a 1% tolerance, 50 is 0.5%.
TOLERANCE_BPS=
# Return the output to the source chain. Defaults to true.
# RETURN_TO_SOURCE=true
# Receives the output on the source chain. Defaults to MY_ADDRESS.
# BENEFICIARY=
# Takes the token back on this chain if the request fails. Defaults to the beneficiary.
# LOCAL_REFUND_ADDRESS=
# Adapter to preview against. Defaults to the adapter field of deployments/ccip/<chainId>.json.
# REQUEST_ADAPTER=

# ------------------------------------------------------------------------------------------------------------------
# pnpm ccip:deploy-example-vault (testnet tutorials only: ExampleERC4626Vault is not audited)
# ------------------------------------------------------------------------------------------------------------------

# Underlying asset of the example vault, for example CCIP-BnM on Ethereum Sepolia.
# VAULT_ASSET=0xUnderlyingToken
# Share token name and symbol.
# VAULT_NAME="Vault CCIP-BnM"
# VAULT_SYMBOL=vCCIP-BnM
# Vault owner (Ownable). Defaults to the broadcaster.
# VAULT_OWNER=
