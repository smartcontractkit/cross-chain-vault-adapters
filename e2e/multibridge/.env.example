# Copy to e2e/multibridge/.env and fill in. Optional variables are commented out: leave them commented unless you
# need them (an empty value is not the same as unset).
# Scripts run from e2e/multibridge (via `pnpm e2e:multibridge <script>` at the
# repo root) and load this file automatically. The shell helpers in script/multibridge/ source it too.

# ---------------------------------------------------------------------------------------------------------
# Config and networks
# ---------------------------------------------------------------------------------------------------------

# JSON config, relative to the repo root. Sepolia testnets: config/multibridge/sepolia.json.
# Tenderly Virtual TestNets: copy config/multibridge/tenderly.example.json to config/multibridge/tenderly.json.
# Defaults to config/multibridge/tenderly.json for initiate/recover and config/multibridge/sepolia.json for inspect.
CONFIG=config/multibridge/sepolia.json

# RPC URLs. The variable names are set per network by `rpcUrlEnv` in the config file.
# Hub = the chain with the vault and the adapter.
HUB_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Spokes = the chains transfers originate from.
SPOKE_A_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SPOKE_BSC_RPC_URL=https://bsc-testnet.public.blastapi.io
SPOKE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ---------------------------------------------------------------------------------------------------------
# Keys (testnet only; never commit a real key)
# ---------------------------------------------------------------------------------------------------------

# 0x-prefixed private key of the originator. It must hold gas and the source token on the spoke you use.
# The Sepolia deploy and sync helpers in script/multibridge/ also sign with it when it is set.
PRIVATE_KEY=
# Etherscan API key, used by `forge script --verify` in the Sepolia deploy helpers (verification is skipped
# when empty).
ETHERSCAN_API_KEY=
# Foundry keystore account the Sepolia helpers sign with when PRIVATE_KEY is empty. Defaults to vaultdeployer.
# FOUNDRY_ACCOUNT=

# ---------------------------------------------------------------------------------------------------------
# initiate (originate a deposit or redeem from a spoke)
# ---------------------------------------------------------------------------------------------------------

# Scenario key from `scenarios` in the config (Sepolia), or leave unset to use the single `scenario` block
# (Tenderly). Example: deposit-fuji-usdc, stargate-arbitrum, redeem-arbitrum.
# SCENARIO=
# Override the scenario's rail: ccip or layerzero (LayerZero OFT and Stargate).
# CHANNEL=
# Adapter profile key from `adapters` in the config (for example usdt or usdc). Defaults to the scenario's.
# ADAPTER_PROFILE=
# 1 = force minAmountOut to max so the hub captures the message as failed (exercises recovery).
# FAIL_SLIPPAGE=
# Hub adapter clone to use instead of adapters.<profile>.app from the config (also honored by recover).
# ADAPTER=
# Bridged vault share token on a spoke, for redeem scenarios, instead of spokes.<key>.shareToken.
# The key is the spoke's config key in upper snake case, for example:
# SPOKE_ARBITRUM_SEPOLIA_SHARE_TOKEN=

# ---------------------------------------------------------------------------------------------------------
# recover (inspect or refund a failed message on the hub)
# ---------------------------------------------------------------------------------------------------------

# CCIP messageId or LayerZero guid printed by initiate (MESSAGE_ID is an alias).
# GUID=
# 1 = only print the failed-message status; don't send a refund.
# CHECK_ONLY=
# Native value (wei) sent with refundToSource to pay the return bridge fee. Default 0.05 ETH; surplus is refunded.
# REFUND_VALUE_WEI=
# Block to start the MessageFailed log search from. Defaults to earliest, which many public RPCs reject.
# FROM_BLOCK=

# ---------------------------------------------------------------------------------------------------------
# inspect:adapter (print an adapter's on-chain configuration)
# ---------------------------------------------------------------------------------------------------------

# The hub adapter clone to inspect is ADAPTER (above); ADAPTER_ADDRESS is an alias.
# Extra comma-separated addresses to check for roles (AccessControl is not enumerable). Config owners,
# fee collectors, the factory and DEPLOYER are always checked.
# ROLE_CANDIDATES=
# Deployer address. Also read by the Sepolia deploy helpers (derived from PRIVATE_KEY or FOUNDRY_ACCOUNT when unset).
# DEPLOYER=
# Factory deployment block. When set, clones are listed from the factory's VaultAdapterDeployed events.
# FACTORY_FROM_BLOCK=
# 1 = print JSON instead of the text report (same as --json).
# JSON=

# 1 = print full stack traces on errors.
# E2E_DEBUG=
