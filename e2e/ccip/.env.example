# ------------------------------------------------------------------------------
# Live-network E2E harness for CrossChainERC4626Adapter (e2e/ccip).
#
#   cp e2e/ccip/.env.example e2e/ccip/.env
#
# The scripts always load e2e/ccip/.env and its values override variables
# already exported in your shell. Run everything from the repo root with
# `pnpm e2e:ccip <script>`; see e2e/ccip/README.md.
#
# Use throwaway testnet wallets only. Never commit e2e/ccip/.env.
# Commented-out lines show the default the code uses when the variable is unset.
# ------------------------------------------------------------------------------

# ---- Lane --------------------------------------------------------------------
# CCIP network names as known to @chainlink/ccip-sdk. Source and destination
# must be different EVM chains (Solana sources use E2E_SOLANA_SOURCE_CHAIN).
E2E_SOURCE_CHAIN=avalanche-testnet-fuji
E2E_DEST_CHAIN=ethereum-testnet-sepolia

# ---- Required for the EVM adapter scripts (deposit, refund-send, redeem, suite)
# JSON-RPC endpoints for the source and destination chains.
E2E_SOURCE_RPC_URL=
E2E_DEST_RPC_URL=
# 0x-prefixed 32-byte hex key of a funded TESTNET wallet. The same key signs on
# both chains: CCIP sends on the source, refund / local recovery on the destination.
E2E_PRIVATE_KEY=
# CCIP Router on the source chain. Prefilled with the Avalanche Fuji router;
# confirm it (or look up another chain's) in the CCIP directory:
# https://docs.chain.link/ccip/directory/testnet
E2E_SOURCE_ROUTER=0xF694E193200268f9a4868e4Aa017A0118C9a8177
# CrossChainERC4626Adapter on the destination chain (the CCIP receiver).
E2E_DEST_ADAPTER=
# ERC-4626 vault on the destination chain. Must be enabled on the adapter
# (setTargetEnabled) and is the payload `target`.
E2E_DEST_VAULT=
# The vault's underlying asset on the destination chain (IERC4626(vault).asset()).
# Redeem `minimumOut` is parsed with this token's decimals.
E2E_DEST_ASSET_TOKEN_ADDRESS=
# Source-chain CCIP token that arrives on the destination as the vault asset
# (for example CCIP test USDC). Deposit scripts bridge this token.
E2E_SOURCE_USDC_TOKEN_ADDRESS=

# ---- Payload options ---------------------------------------------------------
# Payload `beneficiary` (EVM address). Defaults to the E2E_PRIVATE_KEY address.
# Required by bridge-vault (tokens-only receiver on the destination chain).
E2E_DEST_BENEFICIARY=
# Bit 0 of `deliveryAndRefund`. false = deliver vault output to the beneficiary
# on the destination chain. true = bridge the output back to the beneficiary on
# the source chain (the adapter pays that CCIP fee from its native balance; CCIP
# v2 return lanes also need the return-lane format). The code default when unset
# is true.
E2E_RETURN_TO_SOURCE_CHAIN=false
# Bits 1..160 of `deliveryAndRefund`: destination-chain EVM address allowed to
# call recoverFailedMessageLocally for a failed message. Leave empty to disable
# local recovery (only the cross-chain refund remains). For the suite's
# evm-local-recovery-flow it must equal the E2E_PRIVATE_KEY address.
E2E_LOCAL_REFUND_ADDRESS=

# ---- Amounts (human units, parsed with each token's on-chain decimals) --------
# deposit: source USDC amount and minimum vault shares out.
# E2E_DEPOSIT_USDC_AMOUNT=.1
# E2E_DEPOSIT_MINIMUM_OUT=0
# refund-send / failure and recovery scenarios (fall back to the deposit values).
# E2E_INVALID_DEPOSIT_USDC_AMOUNT=1
# E2E_INVALID_DEPOSIT_MINIMUM_OUT=1

# ---- Redeem (redeem, evm-redeem-* scenarios) ----------------------------------
# Vault share token on the source chain (the CCIP-bridged vault share). Required
# by `redeem` and `bridge-vault`; redeem scenarios are skipped when unset.
E2E_SOURCE_VAULT_TOKEN_ADDRESS=
# Decimals override when the bridged share token lacks a readable decimals().
# E2E_SOURCE_VAULT_TOKEN_DECIMALS=
# Vault shares to redeem and minimum underlying (asset units) out.
# E2E_REDEEM_VAULT_AMOUNT=1
# E2E_REDEEM_MINIMUM_OUT=0

# ---- Gas, fees and polling ----------------------------------------------------
# Destination execution gas for adapter sends. Unset = estimate with the CCIP SDK
# (estimateReceiveExecution) and multiply by E2E_CCIP_GAS_MULTIPLIER_BPS.
# E2E_CCIP_GAS_LIMIT=
# E2E_CCIP_GAS_MULTIPLIER_BPS=12000
# msg.value for refundFailedMessage = estimateRefundFee * this / 10000.
# The adapter returns any excess to the caller.
# E2E_REFUND_FEE_MULTIPLIER_BPS=12000
# CCIP API polling for `suite --wait` (milliseconds).
# E2E_STATUS_POLL_MS=15000
# E2E_STATUS_TIMEOUT_MS=1800000
# Only for CCIP v2 lanes whose OnRamp accepts GenericExtraArgsV3: 4-byte
# requestedFinality (8 hex digits). Switches EVM sends to Solidity-encoded
# GenericExtraArgsV3 via Router.ccipSend. Leave unset on CCIP v1 lanes;
# 0x00000000 is treated as unset.
# E2E_OUTBOUND_REQUESTED_FINALITY=

# ---- refund / recover-local ----------------------------------------------------
# Only needs E2E_DEST_RPC_URL, E2E_PRIVATE_KEY and E2E_DEST_ADAPTER (plus
# optionally E2E_DEST_CHAIN). The message id is normally passed as the first
# argument; this is the fallback.
# E2E_REFUND_MESSAGE_ID=

# ---- bridge-vault (tokens-only CCIP send, no adapter) --------------------------
# Needs E2E_SOURCE_RPC_URL, E2E_DEST_RPC_URL, E2E_PRIVATE_KEY, E2E_SOURCE_ROUTER,
# E2E_SOURCE_VAULT_TOKEN_ADDRESS and E2E_DEST_BENEFICIARY.
# Amount falls back to E2E_REDEEM_VAULT_AMOUNT, then 1.
# E2E_BRIDGE_VAULT_AMOUNT=1
# Destination execution gas (uint32). Unset = 0 (no receiver callback).
# E2E_BRIDGE_CCIP_GAS_LIMIT=0

# ---- Suite failure scenarios ----------------------------------------------------
# Deliberately unreachable minimumOut values (human units) that make the adapter
# revert MinimumOutputNotMet.
# E2E_SUITE_FAIL_DEPOSIT_MINIMUM_OUT=999999999
# E2E_SUITE_FAIL_REDEEM_MINIMUM_OUT=999999999

# ---- Solana source (deposit-solana, redeem-solana, svm-* scenarios) ------------
# Also uses E2E_DEST_RPC_URL, E2E_DEST_CHAIN, E2E_DEST_ADAPTER, E2E_DEST_VAULT,
# E2E_DEST_ASSET_TOKEN_ADDRESS and the gas / polling settings above.
# svm-* scenarios are skipped unless E2E_SOLANA_SOURCE_RPC_URL,
# E2E_SOLANA_WALLET_SECRET_KEY, E2E_SOLANA_SOURCE_ROUTER and
# E2E_SOLANA_SOURCE_USDC_TOKEN_MINT are all set.
E2E_SOLANA_SOURCE_CHAIN=solana-devnet
E2E_SOLANA_SOURCE_RPC_URL=
# CCIP Router program on the Solana source. Prefilled with the devnet router;
# confirm it in the CCIP directory.
E2E_SOLANA_SOURCE_ROUTER=Ccip842gzYHhvdDkSyi2YVCoAWPbYJoApMFzSxQroE9C
# Funded devnet keypair: a keypair file path (a leading ~ expands to your home
# directory), a base58 secret key, or the JSON byte array from a keypair file.
E2E_SOLANA_WALLET_SECRET_KEY=
# SPL mint bridged by deposit-solana (arrives on the destination as the vault asset).
E2E_SOLANA_SOURCE_USDC_TOKEN_MINT=
# SPL mint of the bridged vault share; required only by redeem-solana.
E2E_SOLANA_SOURCE_VUSDC_TOKEN_MINT=
# Solana pubkey used as the payload beneficiary when the output returns to
# Solana. Defaults to the wallet's pubkey.
E2E_SOLANA_BENEFICIARY=
# Bit 0 of `deliveryAndRefund` for Solana sends. true = bridge the output back to
# E2E_SOLANA_BENEFICIARY on Solana; false = deliver on the destination chain to
# E2E_DEST_BENEFICIARY (then required). Unset = E2E_RETURN_TO_SOURCE_CHAIN
# (false in this file), then true.
E2E_SOLANA_RETURN_TO_SOURCE_CHAIN=true
# Amounts fall back to the matching EVM deposit / redeem variable, then 1.
# E2E_SOLANA_DEPOSIT_USDC_AMOUNT=1
# E2E_SOLANA_DEPOSIT_MINIMUM_OUT=1
# E2E_SOLANA_REDEEM_VUSDC_AMOUNT=1
# E2E_SOLANA_REDEEM_MINIMUM_OUT=1
