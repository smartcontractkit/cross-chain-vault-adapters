# Copy to frontend/ccip/.env and fill in. Every VITE_* value is inlined into the static bundle at build
# time and is visible to anyone who loads the page: never put secrets here.

# Reown (WalletConnect) Cloud project ID. Required for EVM wallet connection
# (https://cloud.reown.com). Without it the EVM wallet button is disabled.
VITE_REOWN_PROJECT_ID=

# Optional Solana RPC endpoints. Defaults to the public cluster endpoints.
VITE_SOLANA_DEVNET_RPC=
VITE_SOLANA_MAINNET_RPC=

# Optional per-chain EVM RPC overrides: VITE_RPC_<EVM chain id>. Honored for chain ids
# 1, 10, 56, 137, 8453, 42161, 43114, 11155111, 421614, 84532, 11155420, 43113, 80002, 97;
# every other chain uses the public RPC in client/src/config/ccip.config.ts.
VITE_RPC_11155111=
